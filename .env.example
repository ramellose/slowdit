# slowdit configuration — all optional, defaults are sane for a local profile.

# Where per-run dirs (code staging + results) live.
SLOWDIT_RUN_DIR=/var/tmp/slowdit/runs

# Ceiling for per-run timeouts (request values clamp to this).
SLOWDIT_MAX_TIMEOUT=3600

# uid:gid untrusted code runs as inside the container (never 0:0).
SLOWDIT_RUN_USER=1000:1000

# Keep the run dir on non-completed outcomes (for debugging). 1/0.
SLOWDIT_KEEP_FAILED_RUNS=1

# JUnit filename expected in the writable results dir.
SLOWDIT_RESULTS_FILE=results.xml

# MCP serve location (stdio ignores these).
SLOWDIT_MCP_HOST=0.0.0.0
SLOWDIT_MCP_PORT=8790
